# Copy this file to .env and fill in your own values.
# Get these from a Google Programmable Search Engine (https://programmablesearchengine.google.com/):
#   1. Create a search engine, enable "Search the entire web", copy its Search engine ID -> GOOGLE_CSE_ID
#   2. Create an API key for the Custom Search JSON API at
#      https://console.cloud.google.com/apis/credentials (enable "Custom Search API" on the project first)
#      -> GOOGLE_API_KEY
# Free tier: 100 queries/day, then billed per use — see Google's pricing page.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Comma-separated list of sites to scope live search queries to. Optional — defaults to
# fh6tunes.app, forzahorizonhub.com, reddit.com/r/ForzaHorizon if left blank.
TUNE_SITES=

# Port the local server listens on. Optional — defaults to 8000.
PORT=8000
